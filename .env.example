                                                                                                                                                # ── Open Editor backend — AI proxy config ───────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env. The API key stays on
# THIS server and is never sent to the browser.

# Your Groq API key (free tier): https://console.groq.com/keys
# (AI_API_KEY is accepted as an alias if you use a different provider.)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI-compatible base URL. Groq by default. To move to another provider
# later, change this + AI_MODEL (and the key) — nothing else.
AI_BASE_URL=https://api.groq.com/openai/v1

# Model id. Free, capable Groq default:
AI_MODEL=llama-3.3-70b-versatile

# Browser origins allowed to call the proxy (comma-separated). Must include
# wherever your editor is served. The Vite playground default; also include
# 127.0.0.1 if you run the playground's real-license-panel.js demo from that
# origin instead (needed because bare "localhost" can't be domain-bound on a
# license — see apps/playground/README.md — but 127.0.0.1 can):
AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional guards
AI_MAX_PROMPT_CHARS=24000
AI_TIMEOUT_MS=30000
PORT=8787

# ── Database (MySQL) — OPTIONAL ─────────────────────────────────────────────
# The DB powers the LICENSING/ADMIN side (Phase C+). The AI proxy does NOT need
# it. Leave DB_ENABLED unset/false for an AI-only deployment; the app still runs.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=open_editor
# DEV ONLY: auto-create tables from entities. NEVER true in production — use
# migrations. Ignored when NODE_ENV=production.
DB_SYNCHRONIZE=false
# Auto-run pending migrations on boot. Unset → default ON in dev (a behind DB
# self-heals), OFF in production (apply migrations as a deliberate deploy step:
# `npm run migration:run`). Set true/false to override either way.
# DB_MIGRATIONS_RUN=
DB_LOGGING=false

# ── License signing (Phase C) — THE MOST SENSITIVE SECRET ──────────────────
# The ES256 PRIVATE key that signs every license. Anyone with it can mint free
# licenses for every feature. Keep it out of git; in production use a secret
# manager. Generate a keypair with:  npm run key:generate
# Paste the PKCS8 PEM here (newlines may be \n-escaped on one line).
LICENSE_PRIVATE_KEY=
# Key id (goes in each token header; lets you rotate keys). Editors verify
# against the matching PUBLIC key served at /.well-known/jwks.json.
LICENSE_KID=oe-key-1
# Default signed-token lifetime (seconds). SHORT on purpose (30 days) so a
# revoked license stops working within the window — offline verification can't
# know about revocation, so short TTL + auto-renewal IS the revocation model.
# Capped below the editor verifier's ~3-year ceiling.
LICENSE_DEFAULT_TTL_SECONDS=2592000
LICENSE_ISSUER=open-editor
# Key ROTATION: when you replace the private key above, move the OLD key's
# PUBLIC pem here so licenses it already signed keep verifying (JWKS serves
# both). JSON array of { "kid", "publicKeyPem" } (pem may be \n-escaped).
# Example: [{"kid":"oe-key-1","publicKeyPem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}]
LICENSE_RETIRED_KEYS=

# ── Admin auth + RBAC (Phase D) ─────────────────────────────────────────────
# JWT secrets — MUST be set (and different) in production; the app refuses to
# start with the dev fallbacks when NODE_ENV=production. Generate with e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=7d
AUTH_BCRYPT_ROUNDS=12
# Refresh-cookie flags. secure=true (HTTPS) in prod; sameSite strict/lax/none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE=oe_refresh

# First admin user, seeded on boot if absent. In production set a strong
# password (no password + prod → seed is skipped with a warning, never a weak
# default).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# DB driver: 'mysql' (default/prod) or 'sqljs' (in-memory, dev/test only).
DB_DRIVER=mysql

# Admin/auth browser origins (CORS + CSRF Origin check on /auth/refresh).
# Comma-separated; e.g. the open-editor-web admin panel origin.
ADMIN_CORS_ORIGINS=http://localhost:5173

# Shared secret proving the BFF (Next server) to the backend on the
# server-to-server /auth/refresh call. MUST equal BFF_SHARED_SECRET on the web
# app. Set BOTH in production (else silent refresh relies on the origin
# allowlist, which the server-to-server call can't satisfy). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BFF_SHARED_SECRET=

# Set true ONLY for throwaway dev to allow seeding an admin with a default
# password when SEED_ADMIN_PASSWORD is unset. Never set in production.
SEED_DEV_ADMIN=false

# ── Billing / Stripe (Phase F) ──────────────────────────────────────────────
# Self-serve one-time checkout, USD-only, card-only, using Stripe EMBEDDED
# Checkout (the payment form renders ON OUR OWN /checkout page — no redirect to
# checkout.stripe.com). If STRIPE_SECRET_KEY is unset, billing is DISABLED (the
# /billing endpoints 503, the storefront shows "coming soon") and everything
# else still works. Get test keys at https://dashboard.stripe.com/test/apikeys
#
# SECRET key — server-only, never sent to the browser:
# STRIPE_SECRET_KEY=sk_test_...
# PUBLISHABLE key — REQUIRED for embedded checkout. Safe to expose to the
# browser (that's its purpose); the storefront reads it via /public/billing-
# status to mount Stripe.js. Must match the same account/mode as the secret key
# (both test, or both live). Right next to the secret key in the dashboard.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret — REQUIRED to accept webhooks. From the Stripe CLI
# (`stripe listen`) or the dashboard webhook endpoint. Only a signature signed
# with this secret can mint a paid license.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe returns the buyer after payment completes ON our embedded
# checkout page. The {CHECKOUT_SESSION_ID} placeholder is filled by Stripe so
# the success page can poll for the minted license. (Embedded checkout has no
# cancel URL — the buyer simply closes the form.)
# CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}

# Public origin of the storefront (open-editor-web). Used to build the default
# success/cancel URLs above.
WEB_APP_ORIGIN=http://localhost:3000

# From-address for the license email.
# EMAIL_FROM=licenses@yourdomain.com
#
# Email transport — the service picks the FIRST one configured:
#   1) SMTP (below)  2) EMAIL_WEBHOOK_URL  3) dev-log (metadata only).
#
# SMTP (e.g. Gmail). For Gmail use an App Password (Google Account → Security →
# App passwords), NOT your normal password. Port 465 = secure; 587 = STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-app-password        # keep only in .env — NEVER commit
# SMTP_SECURE=false                  # optional; auto-true when SMTP_PORT=465
#
# OR an outbound email webhook (Resend/SES/Postmark or a relay). POSTs JSON
# {from,to,subject,text,html}. Vendor-neutral; no SDK baked in.
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=          # optional bearer sent as Authorization

# ── Production hardening (Phase G) ──────────────────────────────────────────
# Behind a reverse proxy (Caddy/nginx/LB), set to the number of trusted proxy
# hops (e.g. 1) so rate limiting + the CSRF Origin check use the REAL client IP
# from X-Forwarded-For. Leave UNSET for direct local dev (never trust a
# spoofable XFF without a proxy in front).
# TRUST_PROXY=1

# Access-log format. 'json' (default in production) emits one structured line
# per request { level, time, reqId, method, path, status, ms } — no secrets,
# no bodies/headers. 'dev' uses Nest's default logger.
# LOG_FORMAT=json

# Rate limits (requests / window / IP). Sane defaults built in; override to tune.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# THROTTLE_AUTH_TTL_MS=60000
# THROTTLE_AUTH_LIMIT=10
# THROTTLE_CHECKOUT_TTL_MS=600000
# THROTTLE_CHECKOUT_LIMIT=15
# THROTTLE_AI_TTL_MS=60000
# THROTTLE_AI_LIMIT=20           # /api/ai per-IP cap (LLM cost guard)
