{
  "name": "open-editor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Open Editor backend — secure AI proxy (Phase A) → later: licensing/admin (NestJS + MySQL + TypeORM). Independent project; the editor talks to it only via its aiEndpoint URL.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "npm@10.0.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "node scripts/dev-preflight.mjs && nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/database/data-source.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
    "key:generate": "npm run build && node dist/licensing/generate-key.js",
    "test:mysql": "bash scripts/test-mysql.sh",
    "test:mysql:migrations": "bash scripts/test-mysql-migrations.sh",
    "sync:features": "node scripts/sync-feature-catalog.mjs",
    "sync:features:check": "node scripts/sync-feature-catalog.mjs --check",
    "publish:local": "node scripts/publish-local-bundles.mjs",
    "seed:storefront": "node scripts/seed-local-storefront.mjs",
    "check:delivery": "node scripts/check-delivery.mjs",
    "dev:status": "node scripts/dev-status.mjs",
    "sweep:test-licences": "node scripts/sweep-test-licences.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "10.0.2",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "helmet": "^8.3.0",
    "mysql2": "3.11.5",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "stripe": "^22.3.2",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@swc/core": "^1.15.46",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/nodemailer": "^8.0.1",
    "sql.js": "1.12.0",
    "typescript": "5.7.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "1.6.1"
  }
}
